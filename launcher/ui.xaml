<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI OFFICE 서버" Width="1040" Height="700" MinWidth="880" MinHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic, Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#F4EEE4"/>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#3B332B"/>
    <SolidColorBrush x:Key="Ink2" Color="#8A7F72"/>
    <SolidColorBrush x:Key="Line" Color="#E8DFD1"/>
    <SolidColorBrush x:Key="Accent" Color="#F0A03C"/>
    <SolidColorBrush x:Key="Side" Color="#2B2620"/>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#F0A03C"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="#3B332B"/>
      <Setter Property="Background" Value="#F1E8DA"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Padding" Value="13,7"/>
    </Style>
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#E9DCCB"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="10,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="10" Padding="14,10" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3A332B"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#F0A03C"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardB" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.10" Color="#5A4630"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="H" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#3B332B"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8A7F72"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderBrush" Value="#E2D6C4"/>
      <Setter Property="Background" Value="#FBF8F3"/>
      <Setter Property="Foreground" Value="#3B332B"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderBrush" Value="#E2D6C4"/>
      <Setter Property="Background" Value="#FBF8F3"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#3B332B"/>
      <Setter Property="Margin" Value="0,5"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#3B332B"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="Background" Value="#FBF6EE"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
  </Window.Resources>

  <Border Margin="12" CornerRadius="20" Background="{StaticResource Bg}" BorderBrush="#E0D3BF" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.28" Color="#3A2A18"/></Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <!-- 왼쪽 메뉴 -->
      <Border Grid.Column="0" Background="{StaticResource Side}" CornerRadius="20,0,0,20">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Margin="22,24,16,18" x:Name="DragArea" Background="Transparent">
            <StackPanel Orientation="Horizontal">
              <Border Width="40" Height="40" CornerRadius="12" Background="#F0A03C"><TextBlock Text="AI" Foreground="White" FontWeight="Black" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="AI OFFICE" Foreground="#FFF6EA" FontWeight="Black" FontSize="17"/>
                <TextBlock x:Name="VerText" Text="서버 실행기 · v6" Foreground="#B9A88F" FontSize="11"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,20">
            <Border CornerRadius="12" Background="#3A332B" Padding="12,10">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="SideDot" Width="9" Height="9" Fill="#8A7F72" VerticalAlignment="Center"/>
                  <TextBlock x:Name="SideState" Text="확인 중…" Foreground="#FFF6EA" Margin="8,0,0,0" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock x:Name="SideUrl" Text="" Foreground="#B9A88F" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Margin="0,4,0,0">
            <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" GroupName="nav" IsChecked="True" Content="🏠  상태"/>
            <RadioButton x:Name="NavSet" Style="{StaticResource Nav}" GroupName="nav" Content="⚙  서버 설정"/>
            <RadioButton x:Name="NavAdmin" Style="{StaticResource Nav}" GroupName="nav" Content="🔐  관리자 계정"/>
            <RadioButton x:Name="NavLog" Style="{StaticResource Nav}" GroupName="nav" Content="📜  로그"/>
            <RadioButton x:Name="NavCli" Style="{StaticResource Nav}" GroupName="nav" Content="⌨  명령줄 (CLI)"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 오른쪽 -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="Transparent">
          <TextBlock x:Name="PageTitle" Text="상태" FontSize="19" FontWeight="Black" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="26,6,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,14,0" VerticalAlignment="Top">
            <Button x:Name="BtnMin" Style="{StaticResource Ghost}" Content="—" Padding="12,4" Margin="0,0,6,0" ToolTip="최소화"/>
            <Button x:Name="BtnClose" Style="{StaticResource Ghost}" Content="✕" Padding="12,4" ToolTip="닫기"/>
          </StackPanel>
        </Grid>

        <!-- 상태 -->
        <ScrollViewer x:Name="PageHome" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,6,24,10">
          <StackPanel>
            <Border Style="{StaticResource CardB}" Padding="22">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#FFF3E0" Offset="1"/></LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border x:Name="StatePill" CornerRadius="99" Background="#EEE6DA" Padding="12,5">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="#8A7F72" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StateText" Text="확인 중" Margin="8,0,0,0" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <TextBlock x:Name="HeroTitle" Text="AI OFFICE 서버" FontSize="26" FontWeight="Black" Foreground="{StaticResource Ink}" Margin="0,12,0,2"/>
                  <TextBlock x:Name="HeroUrl" Text="" FontSize="14" Foreground="#C77A1E" Cursor="Hand" TextDecorations="Underline"/>
                  <TextBlock x:Name="HeroSub" Text="" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button x:Name="BtnStart" Style="{StaticResource Btn}" Content="▶  서버 시작" FontSize="15" Padding="26,12" Margin="0,0,0,8"/>
                  <Button x:Name="BtnStop" Style="{StaticResource Btn}" Background="#E5534B" Content="■  서버 중지" FontSize="15" Padding="26,12" Margin="0,0,0,8"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnRestart" Style="{StaticResource Ghost}" Content="↻ 재시작" Margin="0,0,6,0"/>
                    <Button x:Name="BtnOpen" Style="{StaticResource Ghost}" Content="🌐 대시보드 열기"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <UniformGrid Columns="5" Margin="0,0,-10,14">
              <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="포트" Style="{StaticResource Hint}"/><TextBlock x:Name="TPort" Text="—" FontSize="20" FontWeight="Black" Foreground="{StaticResource Ink}"/></StackPanel></Border>
              <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="가동 시간" Style="{StaticResource Hint}"/><TextBlock x:Name="TUp" Text="—" FontSize="20" FontWeight="Black" Foreground="{StaticResource Ink}"/></StackPanel></Border>
              <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="세션" Style="{StaticResource Hint}"/><TextBlock x:Name="TSess" Text="—" FontSize="20" FontWeight="Black" Foreground="{StaticResource Ink}"/></StackPanel></Border>
              <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="일함 · 결정 필요" Style="{StaticResource Hint}"/><TextBlock x:Name="TBusy" Text="—" FontSize="20" FontWeight="Black" Foreground="{StaticResource Ink}"/></StackPanel></Border>
              <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="메모리" Style="{StaticResource Hint}"/><TextBlock x:Name="TMem" Text="—" FontSize="20" FontWeight="Black" Foreground="{StaticResource Ink}"/></StackPanel></Border>
            </UniformGrid>

            <Border Style="{StaticResource CardB}">
              <StackPanel>
                <DockPanel><TextBlock Text="최근 로그" Style="{StaticResource H}"/><Button x:Name="BtnMoreLog" Style="{StaticResource Ghost}" Content="전체 보기 →" HorizontalAlignment="Right" Padding="10,4"/></DockPanel>
                <TextBox x:Name="HomeLog" IsReadOnly="True" FontFamily="Consolas, Malgun Gothic" FontSize="12" Height="150" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#2B2620" Foreground="#F3E6D3" BorderThickness="0" Padding="10"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- 설정 -->
        <ScrollViewer x:Name="PageSet" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,6,24,10" Visibility="Collapsed">
          <StackPanel>
            <Border Style="{StaticResource CardB}">
              <StackPanel>
                <TextBlock Text="네트워크" Style="{StaticResource H}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Text="포트" VerticalAlignment="Center" Foreground="{StaticResource Ink}" FontWeight="Bold"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="SPort" Width="110" FontSize="15" FontWeight="Bold"/>
                    <Button x:Name="BtnCheckPort" Style="{StaticResource Ghost}" Content="사용 가능한지 확인" Margin="8,0,0,0"/>
                    <Button x:Name="BtnPortDefault" Style="{StaticResource Ghost}" Content="기본값 17777" Margin="6,0,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="PortHint" Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,6,0,10"/>
                  <TextBlock Grid.Row="2" Text="열어 둘 주소" Foreground="{StaticResource Ink}" FontWeight="Bold" Margin="0,4,0,0"/>
                  <StackPanel Grid.Row="2" Grid.Column="1">
                    <RadioButton x:Name="SHostLocal" GroupName="host" Content="이 PC 에서만 (127.0.0.1) — 권장"/>
                    <RadioButton x:Name="SHostLan" GroupName="host" Content="같은 네트워크에도 열기 (0.0.0.0)"/>
                    <TextBlock Style="{StaticResource Hint}" Text="같은 네트워크로 열면 같은 와이파이 · 사내망의 다른 기기도 접속할 수 있어요. 로그인 없이는 세션 내용이 보이지 않지만, 꼭 필요할 때만 켜세요. 바깥(인터넷)으로 보이려면 Cloudflare 터널처럼 이 PC 주소를 중계하는 방식을 권장해요."/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardB}">
              <StackPanel>
                <TextBlock Text="실행" Style="{StaticResource H}"/>
                <CheckBox x:Name="SOpen" Content="서버가 켜지면 대시보드 열기"/>
                <CheckBox x:Name="SAutoStart" Content="실행기를 열면 서버도 바로 시작"/>
                <CheckBox x:Name="SWatch" Content="서버가 꺼지면 자동으로 다시 켜기 (실행기가 열려 있는 동안)"/>
                <CheckBox x:Name="STray" Content="닫기(✕)를 누르면 알림 영역(트레이)으로 숨기기"/>
                <Separator Margin="0,10" Background="{StaticResource Line}"/>
                <CheckBox x:Name="SLogon" Content="Windows 로그인 때 자동으로 서버 시작"/>
                <TextBlock x:Name="LogonHint" Style="{StaticResource Hint}" Margin="22,0,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardB}">
              <StackPanel>
                <TextBlock Text="경로" Style="{StaticResource H}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Text="Node.js" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                  <TextBox x:Name="SNode" Grid.Column="1"/>
                  <Button x:Name="BtnNodeFind" Grid.Column="2" Style="{StaticResource Ghost}" Content="찾기…" Margin="8,0,0,0"/>
                  <TextBlock x:Name="NodeHint" Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,4,0,8"/>
                  <TextBlock Grid.Row="2" Text="AI OFFICE 폴더" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                  <TextBox x:Name="SRoot" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Background="#F3EEE6"/>
                  <Button x:Name="BtnRootOpen" Grid.Row="2" Grid.Column="2" Style="{StaticResource Ghost}" Content="폴더 열기" Margin="8,0,0,0"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardB}" Background="#FFF6E8">
              <StackPanel>
                <TextBlock Text="포트를 바꾸면 같이 바꿔야 하는 것" Style="{StaticResource H}"/>
                <TextBlock Style="{StaticResource Hint}" Foreground="#6B5B4A" Text="· Cloudflare 터널(cloudflared) 설정의 로컬 주소 (예: http://localhost:17777)&#x0a;· 브라우저 즐겨찾기 · 웹 AI 브리지(bridges/ai-office-web.user.js)의 주소&#x0a;· Claude Code 훅(bridges/claude-hook.mjs)은 이 설정을 자동으로 따라가요"/>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
              <TextBlock x:Name="SaveHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Button x:Name="BtnSave" Style="{StaticResource Btn}" Content="저장" Padding="30,10"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- 관리자 계정 -->
        <ScrollViewer x:Name="PageAdmin" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,6,24,10" Visibility="Collapsed">
          <StackPanel>
            <Border Style="{StaticResource CardB}">
              <StackPanel>
                <TextBlock Text="관리자 계정" Style="{StaticResource H}"/>
                <TextBlock x:Name="AdminState" Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,12"/>
                <Grid MaxWidth="520" HorizontalAlignment="Left">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Text="아이디" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                  <TextBox x:Name="AId" Grid.Column="1" Margin="0,0,0,8"/>
                  <TextBlock Grid.Row="1" Text="비밀번호" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                  <PasswordBox x:Name="APw" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
                  <TextBlock Grid.Row="2" Text="비밀번호 확인" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                  <PasswordBox x:Name="APw2" Grid.Row="2" Grid.Column="1"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,12" Text="비밀번호는 12자 이상. 아이디와 scrypt 해시만 data/auth.json 에 저장되고, 저장하면 지금 로그인된 화면은 모두 로그아웃돼요. (계정 금고는 다음 로그인 때 새 비밀번호로 다시 묶여요)"/>
                <StackPanel Orientation="Horizontal"><Button x:Name="BtnAdminSave" Style="{StaticResource Btn}" Content="관리자 계정 저장" Padding="22,10"/><TextBlock x:Name="AdminMsg" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- 로그 -->
        <Grid x:Name="PageLog" Grid.Row="1" Margin="24,6,24,20" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox x:Name="LogFollow" Content="자동으로 따라가기" IsChecked="True" VerticalAlignment="Center"/>
            <Button x:Name="BtnLogRefresh" Style="{StaticResource Ghost}" Content="새로고침" Margin="14,0,6,0"/>
            <Button x:Name="BtnLogOpen" Style="{StaticResource Ghost}" Content="로그 파일 열기"/>
          </StackPanel>
          <Border Grid.Row="1" CornerRadius="14" Background="#2B2620" Padding="4">
            <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas, Malgun Gothic" FontSize="12" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#F3E6D3" BorderThickness="0" Padding="10"/>
          </Border>
        </Grid>

        <!-- CLI -->
        <ScrollViewer x:Name="PageCli" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,6,24,10" Visibility="Collapsed">
          <StackPanel>
            <Border Style="{StaticResource CardB}">
              <StackPanel>
                <TextBlock Text="명령줄에서 쓰기" Style="{StaticResource H}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="같은 실행 파일을 터미널 · 스크립트 · 작업 스케줄러에서 그대로 쓸 수 있어요. 인자 없이 실행하면 이 창이 열려요."/>
                <TextBox x:Name="CliText" IsReadOnly="True" FontFamily="Consolas, Malgun Gothic" FontSize="12.5" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" Background="#2B2620" Foreground="#F3E6D3" BorderThickness="0" Padding="14"/>
                <Button x:Name="BtnCliCopy" Style="{StaticResource Ghost}" Content="복사" HorizontalAlignment="Right" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22" CornerRadius="99" Background="#2B2620" Padding="18,9" Visibility="Collapsed">
          <TextBlock x:Name="ToastText" Foreground="#FFF6EA" FontWeight="Bold"/>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
